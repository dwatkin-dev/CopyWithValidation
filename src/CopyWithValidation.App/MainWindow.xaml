<Window x:Class="CopyWithValidation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CopyWithValidation.App"
        mc:Ignorable="d"
        Title="Copy With Validation" Height="220" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0 -->
        <Label 
            Margin="5" 
            Grid.Row="0" 
            Grid.Column="0" 
            Content="Source file" />
        
        <TextBox 
            Margin="5" 
            Grid.Row="0" 
            Grid.Column="1" 
            x:Name="SourceTextBox"
            IsEnabled="False" />
        
        <Button 
            x:Name="BrowseSourceButton"
            Margin="5" 
            Grid.Row="0" 
            Grid.Column="2" 
            Content="Browse..."
            Click="BrowseSourceButton_Click"/>

        <!-- Row 1 -->
        <Label 
            Margin="5" 
            Grid.Row="1" 
            Grid.Column="0" 
            Content="Destination folder" />
        
        <TextBox 
            Margin="5" 
            Grid.Row="1" 
            Grid.Column="1" 
            x:Name="DestinationTextBox"
            IsEnabled="False" />
        
        <Button 
            Margin="5" 
            Grid.Row="1" 
            Grid.Column="2" 
            Content="Browse..."
            x:Name="BrowseDestinationButton"
            Click="BrowseDestinationButton_Click" />

        <!-- Row 2 -->
        <Button 
            Margin="5"
            HorizontalAlignment="Left"
            Grid.Row="2" 
            Grid.Column="1" 
            Content="Copy and verify"
            x:Name="CopyButton"
            Click="CopyButton_Click"/>

        <!-- Row 3 -->
        <ProgressBar
            Margin="5"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="20"
            x:Name="CopyProgressBar" />

        <!-- Row 4 -->
        <TextBlock 
            Margin="5" 
            Grid.Row="4" 
            Grid.Column="0" 
            Grid.ColumnSpan="3" 
            x:Name="ResultTextBlock" />
    </Grid>
</Window>
